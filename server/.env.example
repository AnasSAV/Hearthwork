# Copy to server/.env (never commit .env).
PORT=2567

# Supabase project URL: Dashboard → Project Settings → API (or `supabase status` locally).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. SERVER ONLY. Never put this in client/.env.
SUPABASE_SERVICE_ROLE_KEY=
