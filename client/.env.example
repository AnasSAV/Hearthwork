# Copy to client/.env (never commit .env). Everything here ends up in the browser bundle.

# Game server URL (http/https; the SDK switches to ws/wss itself).
VITE_SERVER_URL=http://localhost:2567

# Supabase project URL and the PUBLIC key: publishable key (sb_publishable_...) or legacy anon key.
# Never the secret/service_role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=
